{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lankaserve",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "0 2 * * *",
      "30 2 * * *",
      "0 3 * * *",
      "0 4 * * *"
    ]
  }
}
